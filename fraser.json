 "sections": [
  {
   "id": "p",
   "n": 0,
   "sv": "Min vanliga dag",
   "en": "My ordinary day",
   "items": [
    {
     "id": "p0",
     "sv": "Hej! Jag heter Mubas och jag bor i Esbo.",
     "h": "Hej! Ja<s class=\"sil\">g</s> heter Mubas o<s class=\"sil\">ch</s> ja<s class=\"sil\">g</s> bor i Esbo.",
     "en": "Hi! My name is Mubas and I live in Espoo."
    },
    {
     "id": "p1",
     "sv": "En vanlig dag börjar klockan sju.",
     "h": "En vanli<s class=\"sil\">g</s> da<s class=\"sil\">g</s> börjar klockan sju.",
     "en": "An ordinary day starts at seven."
    },
    {
     "id": "p2",
     "sv": "Först dricker jag kaffe, sedan tar jag bussen till jobbet.",
     "h": "Först dricker ja<s class=\"sil\">g</s> kaffe, se<s class=\"sil\">da</s>n tar ja<s class=\"sil\">g</s> bussen till jobbet.",
     "en": "First I drink coffee, then I take the bus to work."
    },
    {
     "id": "p3",
     "sv": "På jobbet säger jag ”Hej, hur mår du?” till mina kollegor.",
     "h": "På jobbet säger ja<s class=\"sil\">g</s> ”Hej, hur mår du?” till mina kollegor.",
     "en": "At work I say “Hi, how are you?” to my colleagues."
    },
    {
     "id": "p4",
     "sv": "Ibland ringer jag till en kund: ”Hej, det är Mubas. Jag ringer för att boka en tid.”",
     "h": "Ibland ringer ja<s class=\"sil\">g</s> till en kund: ”Hej, de<s class=\"sil\">t</s> är Mubas. Ja<s class=\"sil\">g</s> ringer för att boka en tid.”",
     "en": "Sometimes I call a customer: “Hi, it's Mubas. I'm calling to book an appointment.”"
    },
    {
     "id": "p5",
     "sv": "Om jag inte förstår säger jag: ”Kan du upprepa det, tack?”",
     "h": "Om ja<s class=\"sil\">g</s> inte förstår säger ja<s class=\"sil\">g</s>: ”Kan du upprepa de<s class=\"sil\">t</s>, tack?”",
     "en": "If I don't understand, I say: “Can you repeat that, please?”"
    },
    {
     "id": "p6",
     "sv": "På lunchen pratar vi om helgen.",
     "h": "På lunchen pratar vi om helgen.",
     "en": "At lunch we talk about the weekend."
    },
    {
     "id": "p7",
     "sv": "En kollega berättar att hon ska flytta. ”Vad kul! Lycka till!” säger jag.",
     "h": "En kollega berättar att hon ska flytta. ”Va<s class=\"sil\">d</s> kul! Lycka till!” säger ja<s class=\"sil\">g</s>.",
     "en": "A colleague says she is going to move. “How nice! Good luck!” I say."
    },
    {
     "id": "p8",
     "sv": "Efter jobbet handlar jag mat.",
     "h": "Efter jobbet handlar ja<s class=\"sil\">g</s> mat.",
     "en": "After work I buy food."
    },
    {
     "id": "p9",
     "sv": "Ibland fungerar inte kortet, och då frågar jag: ”Kan jag betala kontant i stället?”",
     "h": "Ibland fungerar inte kortet, o<s class=\"sil\">ch</s> då frågar ja<s class=\"sil\">g</s>: ”Kan ja<s class=\"sil\">g</s> betala kontant i stället?”",
     "en": "Sometimes the card doesn't work, and then I ask: “Can I pay in cash instead?”"
    },
    {
     "id": "p10",
     "sv": "På kvällen ringer jag min familj.",
     "h": "På kvällen ringer ja<s class=\"sil\">g</s> min familj.",
     "en": "In the evening I call my family."
    },
    {
     "id": "p11",
     "sv": "Vi pratar om dagen, och till sist säger jag: ”Ta hand om dig! Vi ses snart.”",
     "h": "Vi pratar om dagen, o<s class=\"sil\">ch</s> till sist säger ja<s class=\"sil\">g</s>: ”Ta hand om di<s class=\"sil\">g</s>! Vi ses snart.”",
     "en": "We talk about the day, and finally I say: “Take care! See you soon.”"
    },
    {
     "id": "p12",
     "sv": "Sammanfattningsvis är det en lugn och trevlig dag.",
     "h": "Sammanfattningsvis är de<s class=\"sil\">t</s> en lugn o<s class=\"sil\">ch</s> trevli<s class=\"sil\">g</s> da<s class=\"sil\">g</s>.",
     "en": "All in all, it's a calm and pleasant day."
    }
   ]
  },
  {
   "id": "g0",
   "n": 1,
   "sv": "Hälsa och avsluta",
